# Copie ce fichier en ".env" et adapte les valeurs.

# --- Zone de recherche -----------------------------------------------------
# Centre + rayon (km) : par defaut un point median Bayonne <-> Cambo-les-Bains,
# rayon 20 km, ce qui couvre Bayonne/Anglet/Biarritz/Bidart jusqu'a Cambo.
LATITUDE=43.426
LONGITUDE=-1.367
RAYON_KM=20

# Codes ROME cibles pour la recherche La Bonne Alternance (defaut : systemes,
# reseaux, securite informatique). Voir https://candidat.francetravail.fr/metierscope
ROMES=M1801,M1802,I1401

# Nom de ton projet, demande par l'API La Bonne Alternance pour s'identifier.
LBA_CALLER=alternance-hunter-bab

# --- Google Places (optionnel) ---------------------------------------------
# Laisse vide pour desactiver cette source. Cle a creer sur console.cloud.google.com
# (active "Places API", facturation requise mais un quota gratuit mensuel existe).
GOOGLE_PLACES_API_KEY=
MOTS_CLES_PLACES=ESN,société informatique,infogérance,sécurité informatique,réseaux informatiques

# --- Identite du candidat (utilisee dans les brouillons de candidature) ----
NOM_CANDIDAT=
TELEPHONE_CANDIDAT=
EMAIL_CANDIDAT=
# Chemin vers ton CV (PDF), joint automatiquement a chaque envoi.
CV_FILE=data/cv.pdf

# --- Envoi des emails (SMTP) -------------------------------------------------
# Exemple avec un compte Gmail : cree un "mot de passe d'application" (pas ton
# mot de passe normal) sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR=
EMAIL_REPONSE_A=

# --- Notifications (optionnel, meme systeme que crous-watch-bayonne) -------
# Canal : "ntfy" (zero compte) ou "telegram"
CANAL=ntfy
NTFY_TOPIC=alternance-bab-CHANGE-MOI-x7f2a
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
